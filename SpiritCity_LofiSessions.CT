<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>35</ID>
      <Description>[Resolve Game Pointers (Auto-runs on attach)]</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
sc_resolveAll()
{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>36</ID>
      <Description>[Master Hook] EXP &amp; Credits Multiplier + Free Shop + Fast Lure</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
sc_resolveAll()
{$asm}

aobscanmodule(plsf_aob, SpiritCity-Win64-Shipping.exe, 48 89 5C 24 20 56 57 41 56 48 83 EC 70 48 8B 05 ?? ?? ?? ?? 48 33 C4 48 89 44 24 60)
alloc(newmem, 2048, plsf_aob)

label(hook_entry)
label(check_credits)
label(check_debit)
label(do_free_shop)
label(check_lure)
label(xp_write)
label(xp_done)
label(orig_code)
label(return_here)

label(SC_XP_MULT)
label(SC_CR_MULT)
label(SC_XP_EN)
label(SC_CR_EN)
label(SC_FREE_SHOP)
label(SC_FAST_LURE)
label(SC_LURE_SEC)
label(SC_FN_ADD_XP_SYM)
label(SC_FN_ADD_CR_SYM)
label(SC_FN_DEB_CR_SYM)
label(SC_FN_CAN_BUY_SYM)
label(SC_FN_LURE_SYM)
label(SC_XP_CALLS)
label(SC_LAST_RAW_XP)
label(SC_LAST_MULT_XP)

registersymbol(plsf_aob)
registersymbol(SC_XP_MULT)
registersymbol(SC_CR_MULT)
registersymbol(SC_XP_EN)
registersymbol(SC_CR_EN)
registersymbol(SC_FREE_SHOP)
registersymbol(SC_FAST_LURE)
registersymbol(SC_LURE_SEC)
registersymbol(SC_XP_CALLS)
registersymbol(SC_LAST_RAW_XP)
registersymbol(SC_LAST_MULT_XP)

newmem:
SC_XP_MULT:
  dd (float)5.0
SC_CR_MULT:
  dd (float)1.0
SC_XP_EN:
  dd 1
SC_CR_EN:
  dd 0
SC_FREE_SHOP:
  dd 0
SC_FAST_LURE:
  dd 0
SC_LURE_SEC:
  dd (float)0.05
  dd 0
SC_FN_ADD_XP_SYM:
  dq SC_FN_ADD_XP
SC_FN_ADD_CR_SYM:
  dq SC_FN_ADD_CR
SC_FN_DEB_CR_SYM:
  dq SC_FN_DEBIT_CR
SC_FN_CAN_BUY_SYM:
  dq SC_FN_CAN_BUY
SC_FN_LURE_SYM:
  dq SC_FN_LURE
SC_XP_CALLS:
  dq 0
SC_LAST_RAW_XP:
  dd 0
SC_LAST_MULT_XP:
  dd 0

hook_entry:
  mov r9,[rdx+10]
  mov r10,[rdx+28]
  test r10,r10
  jz orig_code

  cmp r9,[SC_FN_ADD_XP_SYM]
  jne check_credits
  inc qword ptr [SC_XP_CALLS]
  mov eax,[r10]
  mov [SC_LAST_RAW_XP],eax
  mov r11d,[SC_XP_EN]
  test r11d,r11d
  jz xp_done
  test eax,eax
  jle xp_done
  cvtsi2ss xmm0,eax
  movss xmm1,[SC_XP_MULT]
  mulss xmm0,xmm1
  cvttss2si eax,xmm0
  test eax,eax
  jg xp_write
  xorps xmm0,xmm0
  ucomiss xmm1,xmm0
  jbe xp_write
  mov eax,1
xp_write:
  mov [r10],eax
xp_done:
  mov [SC_LAST_MULT_XP],eax
  jmp orig_code

check_credits:
  cmp r9,[SC_FN_ADD_CR_SYM]
  jne check_debit
  mov r11d,[SC_CR_EN]
  test r11d,r11d
  jz orig_code
  mov eax,[r10]
  test eax,eax
  jle orig_code
  cvtsi2ss xmm0,eax
  movss xmm1,[SC_CR_MULT]
  mulss xmm0,xmm1
  cvttss2si eax,xmm0
  mov [r10],eax
  jmp orig_code

check_debit:
  cmp r9,[SC_FN_DEB_CR_SYM]
  je do_free_shop
  cmp r9,[SC_FN_CAN_BUY_SYM]
  jne check_lure
do_free_shop:
  mov r11d,[SC_FREE_SHOP]
  test r11d,r11d
  jz orig_code
  mov dword ptr [r10],0
  jmp orig_code

check_lure:
  cmp r9,[SC_FN_LURE_SYM]
  jne orig_code
  mov r11d,[SC_FAST_LURE]
  test r11d,r11d
  jz orig_code
  mov eax,[SC_LURE_SEC]
  mov [r10],eax

orig_code:
  mov [rsp+20],rbx
  jmp return_here

plsf_aob:
  jmp hook_entry
return_here:

[DISABLE]
plsf_aob:
  db 48 89 5C 24 20

unregistersymbol(plsf_aob)
unregistersymbol(SC_XP_MULT)
unregistersymbol(SC_CR_MULT)
unregistersymbol(SC_XP_EN)
unregistersymbol(SC_CR_EN)
unregistersymbol(SC_FREE_SHOP)
unregistersymbol(SC_FAST_LURE)
unregistersymbol(SC_LURE_SEC)
unregistersymbol(SC_XP_CALLS)
unregistersymbol(SC_LAST_RAW_XP)
unregistersymbol(SC_LAST_MULT_XP)
dealloc(newmem)
</AssemblerScript>

  <UserdefinedSymbols/>
  <LuaScript>-- Spirit City: Lofi Sessions — Cheat Engine 7.x UE5.7 Dynamic Resolver &amp; EXP Slider GUI
local PROC_NAME = "SpiritCity-Win64-Shipping.exe"

local function sc_readName(fnp, idx)
  local blk = idx &gt;&gt; 16
  local off = (idx &amp; 0xFFFF) * 2
  local blkPtr = readQword(fnp + 0x10 + blk * 8)
  if not blkPtr or blkPtr == 0 then return "" end
  local hdr = readSmallInteger(blkPtr + off)
  if not hdr then return "" end
  local isWide = (hdr &amp; 1) ~= 0
  local len = hdr &gt;&gt; 6
  if len &lt;= 0 or len &gt; 256 then return "" end
  if isWide then
    local b = readBytes(blkPtr + off + 2, len * 2, true)
    if not b then return "" end
    local out = {}
    for i = 1, #b, 2 do
      out[#out + 1] = string.char(b[i] &amp; 0x7F)
    end
    return table.concat(out)
  end
  return readString(blkPtr + off + 2, len, false) or ""
end

local function sc_getObjName(fnp, obj)
  if not obj or obj == 0 then return "" end
  local n_idx = readInteger(obj + 0x18)
  local n_num = readInteger(obj + 0x1C)
  if not n_idx then return "" end
  local s = sc_readName(fnp, n_idx)
  if n_num and n_num &gt; 0 then s = s .. "_" .. tostring(n_num - 1) end
  return s
end

local function sc_findFunc(fnp, clsPtr, targetName)
  local cur = clsPtr
  local depth = 0
  while cur and cur ~= 0 and depth &lt; 12 do
    local ch = readQword(cur + 0x48)
    while ch and ch ~= 0 do
      if sc_getObjName(fnp, ch) == targetName then
        return ch
      end
      ch = readQword(ch + 0x28)
    end
    cur = readQword(cur + 0x40)
    depth = depth + 1
  end
  return 0
end

function sc_resolveAll()
  if getOpenedProcessID() == 0 or process ~= PROC_NAME then
    openProcess(PROC_NAME)
  end
  if getOpenedProcessID() == 0 then
    error("SpiritCity-Win64-Shipping.exe is not running!")
  end

  local gwRef = AOBScanModuleUnique(PROC_NAME, "8B 40 30 48 85 C0 75 07 48 8B 05 ?? ?? ?? ?? C3 CC")
  if not gwRef then error("Could not find GWorld AOB!") end
  local gwDisp = readInteger(gwRef + 11, true)
  local gwPtr = gwRef + 15 + gwDisp
  registerSymbol("SC_GWorld", gwPtr, true)

  local fnRef = AOBScanModuleUnique(PROC_NAME, "74 09 4C 8D 3D ?? ?? ?? ?? EB 16 48 8D 0D")
  if not fnRef then error("Could not find FNamePool AOB!") end
  local fnDisp = readInteger(fnRef + 5, true)
  local fnp = fnRef + 9 + fnDisp
  registerSymbol("SC_FNamePool", fnp, true)

  local world = readQword(gwPtr)
  if not world or world == 0 then error("UWorld not loaded yet.") end
  local gi = readQword(world + 0x228)
  local lpArr = readQword(gi + 0x38)
  local lp = readQword(lpArr)
  local pc = readQword(lp + 0x30)
  local sim = readQword(pc + 0x798)
  local pcCls = readQword(pc + 0x10)
  local simCls = readQword(sim + 0x10)

  local fnAddXP = sc_findFunc(fnp, pcCls, "Add XP")
  local fnAddCr = sc_findFunc(fnp, pcCls, "Add Spirit Credits")
  local fnDebCr = sc_findFunc(fnp, pcCls, "Debit Spirit Credits")
  local fnCanBuy = sc_findFunc(fnp, pcCls, "Check if can buy item")
  local fnLure = sc_findFunc(fnp, simCls, "StartSpiritLuringTimer")

  registerSymbol("SC_FN_ADD_XP", fnAddXP, true)
  registerSymbol("SC_FN_ADD_CR", fnAddCr, true)
  registerSymbol("SC_FN_DEBIT_CR", fnDebCr, true)
  registerSymbol("SC_FN_CAN_BUY", fnCanBuy, true)
  registerSymbol("SC_FN_LURE", fnLure, true)
  return true
end

-- Built-in Cheat Engine Slider GUI for EXP Multiplier &amp; Game Speed
local scForm = nil
function sc_openSliderUI()
  if scForm ~= nil then
    scForm.show()
    return
  end

  scForm = createForm(true)
  scForm.Caption = "Spirit City — EXP Multiplier Slider"
  scForm.Width = 420
  scForm.Height = 250
  scForm.Color = 0x211414
  scForm.Position = "poScreenCenter"

  local title = createLabel(scForm)
  title.Caption = "EXP Earned Multiplier Slider"
  title.Left = 16; title.Top = 12
  title.Font.Size = 12; title.Font.Style = "[fsBold]"; title.Font.Color = 0xDACA73

  local valLbl = createLabel(scForm)
  valLbl.Caption = "1.00x"
  valLbl.Left = 330; valLbl.Top = 12
  valLbl.Font.Size = 12; valLbl.Font.Style = "[fsBold]"; valLbl.Font.Color = 0x77C1F6

  local tb = createTrackBar(scForm)
  tb.Left = 16; tb.Top = 46; tb.Width = 384
  tb.Min = 0; tb.Max = 200; tb.Position = 4 -- 4 * 0.25 = 1.00x
  tb.TickStyle = "tsNone"

  local function applyXpMult(mult)
    valLbl.Caption = string.format("%.2fx", mult)
    local addr = getAddressSafe("SC_XP_MULT")
    if addr then
      writeFloat(addr, mult)
      writeInteger("SC_XP_EN", 1)
    end
  end

  tb.OnChange = function()
    applyXpMult(tb.Position * 0.25)
  end

  local presets = {1, 2, 5, 10, 25, 50}
  for i, p in ipairs(presets) do
    local b = createButton(scForm)
    b.Caption = tostring(p) .. "x"
    b.Left = 16 + (i - 1) * 64
    b.Top = 92; b.Width = 58; b.Height = 26
    b.OnClick = function()
      tb.Position = math.floor(p * 4)
      applyXpMult(p)
    end
  end

  local spdLbl = createLabel(scForm)
  spdLbl.Caption = "Game Speed (TimeDilation): 1.0x"
  spdLbl.Left = 16; spdLbl.Top = 136
  spdLbl.Font.Size = 10; spdLbl.Font.Color = 0xF4DEE0

  local tbSpd = createTrackBar(scForm)
  tbSpd.Left = 16; tbSpd.Top = 160; tbSpd.Width = 384
  tbSpd.Min = 1; tbSpd.Max = 200; tbSpd.Position = 10 -- 10 * 0.1 = 1.0x
  tbSpd.TickStyle = "tsNone"
  tbSpd.OnChange = function()
    local spd = tbSpd.Position * 0.1
    spdLbl.Caption = string.format("Game Speed (TimeDilation): %.1fx", spd)
    local gw = getAddressSafe("SC_GWorld")
    if gw then
      local w = readQword(gw)
      if w and w ~= 0 then
        local lvl = readQword(w + 0x30)
        local ws = lvl and readQword(lvl + 0x2B0) or 0
        if ws and ws ~= 0 then
          writeFloat(ws + 0x3E8, spd)
        end
      end
    end
  end

  local info = createLabel(scForm)
  info.Caption = "Tip: Activate '[Master Hook]' in Cheat Engine first!"
  info.Left = 16; info.Top = 212
  info.Font.Size = 8; info.Font.Color = 0xAA8C90

  scForm.OnClose = function()
    scForm.hide()
    return caHide
  end
end

-- Auto-attach &amp; resolve pointers on table open if game is running
pcall(function()
  if getProcessIDFromProcessName(PROC_NAME) then
    sc_resolveAll()
  end
end)
</LuaScript>
</CheatTable>
